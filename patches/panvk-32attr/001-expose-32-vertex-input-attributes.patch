diff --git a/src/panfrost/vulkan/panvk_cmd_draw.h b/src/panfrost/vulkan/panvk_cmd_draw.h
index 9943277..d56a73d 100644
--- a/src/panfrost/vulkan/panvk_cmd_draw.h
+++ b/src/panfrost/vulkan/panvk_cmd_draw.h
@@ -27,7 +27,11 @@
 #include "pan_fb.h"
 #include "pan_props.h"
 
-#define MAX_VBS 16
+/* The hardware supports up to 2^9 vertex attributes/bindings, only our own
+ * bookkeeping limits this.  Expose 32 attributes, which is what D3D11
+ * (and therefore DXVK) needs, instead of the Vulkan minimum of 16.
+ */
+#define MAX_VBS 32
 
 #if PAN_ARCH < 10
 #define MAX_FRAMEBUFFER_DIMENSION (1 << 14)
diff --git a/src/panfrost/vulkan/panvk_shader.h b/src/panfrost/vulkan/panvk_shader.h
index bf2904f..0bea0ae 100644
--- a/src/panfrost/vulkan/panvk_shader.h
+++ b/src/panfrost/vulkan/panvk_shader.h
@@ -33,7 +33,12 @@ struct panvk_device;
 VkResult panvk_per_arch(create_depth_bounds_fs)(struct panvk_device *dev);
 
 #define MAX_RTS 8
-#define MAX_VS_ATTRIBS 16
+/* Number of MALI_ATTRIBUTE slots reserved at the start of the VS attribute
+ * table (images are placed right after this range on pre-Valhall).  The
+ * hardware supports up to 2^9 attributes, so 32 is a safe software limit and
+ * matches the D3D11 limit.
+ */
+#define MAX_VS_ATTRIBS 32
 
 #if PAN_ARCH < 9
 
