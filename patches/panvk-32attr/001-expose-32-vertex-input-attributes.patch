From 4b7d1e0c9a2f3b4d5e6f708192a3b4c5d6e7f809 Mon Sep 17 00:00:00 2001
From: panvk-kbase-android worker <panvk-worker@localhost>
Date: Fri, 23 Oct 2026 22:40:00 +0700
Subject: [PATCH panvk-32attr 001] panvk: advertise 32 vertex input
 attributes and bindings

maxVertexInputAttributes/maxVertexInputBindings were pinned to the Vulkan
minimum of 16 (MAX_VBS), our own bookkeeping limit: the Mali hardware
supports up to 2^9 vertex attributes.  D3D11 - and therefore DXVK - wants
32 input elements.

Bisect note: advertising 32 while keeping MAX_VS_ATTRIBS at 16 (v0.3.8)
made the frame black with the game nearly hanging: the app builds pipelines
whose vertex shaders read locations 16..31, and those MALI_ATTRIBUTE
descriptors did not exist.  Widening MAX_VS_ATTRIBS to 32 alone (v0.3.5/
v0.3.6) was black too, because panvk_vX_nir_lower_descriptors.c hardcodes
the VS dummy-sampler index to 16 while prepare_vs_driver_set() places it
after the attribute table - every VS UBO/SSBO/texture handle ended up off
by MAX_VS_ATTRIBS - 16 entries.  panvk-g610/016 fixes that and reserves
the 32 slots.

Tested GPU: none yet (compile-level)
Mesa base range: 5a07217f034b3e50d8c7c7794f97a2df1742613b
---
 src/panfrost/vulkan/csf/panvk_cmd_buffer.h | 2 +-
 src/panfrost/vulkan/panvk_cmd_draw.h       | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_cmd_buffer.h b/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
index c1c24d6..6c8a2bc 100644
--- a/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
@@ -32,7 +32,7 @@ struct panvk_sync_scope {
    VkAccessFlags2 access;
 };
 
-#define MAX_VBS 16
+#define MAX_VBS 32
 #define MAX_RTS 8
 #if PAN_ARCH >= 14
 #define MAX_LAYERS_PER_TILER_DESC 256
diff --git a/src/panfrost/vulkan/panvk_cmd_draw.h b/src/panfrost/vulkan/panvk_cmd_draw.h
index 9943277..91b1c2d 100644
--- a/src/panfrost/vulkan/panvk_cmd_draw.h
+++ b/src/panfrost/vulkan/panvk_cmd_draw.h
@@ -27,7 +27,7 @@
 #include "pan_fb.h"
 #include "pan_props.h"
 
-#define MAX_VBS 16
+#define MAX_VBS 32
 
 #if PAN_ARCH < 10
 #define MAX_FRAMEBUFFER_DIMENSION (1 << 14)
-- 
