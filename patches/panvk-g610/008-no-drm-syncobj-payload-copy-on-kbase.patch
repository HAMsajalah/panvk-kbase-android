From 9f4e2d1c3b5a60718293a4b5c6d7e8f901234567 Mon Sep 17 00:00:00 2001
From: panvk-kbase-android worker <panvk-worker@localhost>
Date: Sat, 24 Oct 2026 09:00:00 +0700
Subject: [PATCH panvk-g610 008] panvk/csf: no DRM syncobj payload copy on kbase

A recompiled game (com.antutu.benchmark.full, and any app that presents
through VK_ANDROID_native_buffer) draws black on Mali-G610 MC4.  The
only driver log is, once per frame:

  E/vulkan: QueueSignalReleaseImageANDROID failed: -13

-13 is VK_ERROR_UNKNOWN.  vk_common_QueueSignalReleaseImageANDROID() has
two paths: with device->copy_sync_payloads set it calls
vk_device_copy_semaphore_payloads(), otherwise it does a QueueSubmit2.
Upstream panvk sets copy_sync_payloads = vk_drm_syncobj_copy_payloads
unconditionally, but on kbase the syncs are kbase_cpu_sync (no DRM
syncobj), so the DRM copy issues syncobj ioctls on a non-DRM fd and every
present fails, the native fence fd is never produced and nothing is shown.

Leave copy_sync_payloads NULL on kbase so the QueueSubmit2 path is used;
the semaphore wait/signal resolves on the CPU (kbase_cpu_sync) and the
sync-file export then produces the fence SurfaceFlinger waits on.

Tested GPU: none yet (Mali-G610 MC4 report only)
Validation test: Antutu 3D / recompiled game shows frames on Mali-G610

--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -564,7 +564,17 @@ panvk_per_arch(create_device)(struct panvk_physical_device *physical_device,
    device->vk.shader_ops = &panvk_per_arch(device_shader_ops);
    device->vk.check_status = panvk_device_check_status;
    device->vk.get_timestamp = panvk_device_get_timestamp;
-   device->vk.copy_sync_payloads = vk_drm_syncobj_copy_payloads;
+   /* kbase has no DRM syncobjs: its syncs are kbase_cpu_sync, so
+    * vk_drm_syncobj_copy_payloads would cast them wrongly and issue syncobj
+    * ioctls on a non-DRM fd.  That makes vkQueueSignalReleaseImageANDROID
+    * (the VK_ANDROID_native_buffer present) fail every frame with
+    * VK_ERROR_UNKNOWN (-13), so a game that presents that way draws black.
+    * NULL makes vk_common_QueueSignalReleaseImageANDROID take the
+    * QueueSubmit2 path instead. */
+#ifdef HAVE_PAN_KMOD_KBASE
+   if (!physical_device->kbase_node_path[0])
+#endif
+      device->vk.copy_sync_payloads = vk_drm_syncobj_copy_payloads;
 
    device->kmod.allocator = (struct pan_kmod_allocator){
       .zalloc = panvk_kmod_zalloc,
-- 
